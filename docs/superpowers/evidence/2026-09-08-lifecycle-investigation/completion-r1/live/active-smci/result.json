    },
    {
      "corpus": "web",
      "coverage": "captured_document",
      "end_char": 112398,
      "passage_id": "source-1:p308",
      "published_at": null,
      "publisher": "www.sec.gov",
      "retrieved_at": "2026-09-07T22:30:05.017850+00:00",
      "source_id": "source-1",
      "start_char": 111813,
      "text": "We were incorporated in California in September 1993 and subsequently reincorporated in Delaware in March 2007. Our common stock is listed on the Nasdaq Global Select Market under the symbol “SMCI”. Our 7.00% Series A Mandatory Convertible Preferred Stock (the “Mandatory Convertible Preferred Stock”) in the form of depositary shares are listed on the Nasdaq Global Select Market under the ticker “SMCIP”. Our principal executive offices are located at 980 Rock Avenue, San Jose, California 95131. Our telephone number is (408) 503-8000, and our website address is www.supermicro.com.",
      "text_sha256": "d2386c07f325e3dfe85e0eb1a0d3f3256df113eb4ef99b7d53a2f423309eb21d",
      "title": null,
      "url": "https://www.sec.gov/Archives/edgar/data/1375365/000137536526000022/smci-20260630.htm"
    },
    {
      "corpus": "web",
      "coverage": "captured_document",
      "end_char": 247731,
      "passage_id": "source-1:p654",
      "published_at": null,
      "publisher": "www.sec.gov",
      "retrieved_at": "2026-09-07T22:30:05.017850+00:00",
      "source_id": "source-1",
      "start_char": 247378,
      "text": "Our common stock is traded on the Nasdaq Global Select Market under the symbol SMCI. Public trading of our common stock began on March 29, 2007. Prior to that, there was no public market for our common stock. Our Mandatory Convertible Preferred Stock in the form of depositary shares are listed on the Nasdaq Global Select Market under the symbol SMCIP.",
      "text_sha256": "aacb108b857f24441249a28af1244cb1ab93ad5b6ff2a78b846ed477850f856c",
      "title": null,
