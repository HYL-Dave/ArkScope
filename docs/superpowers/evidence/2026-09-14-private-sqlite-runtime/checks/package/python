#!/bin/sh
set -eu
SELF=$(readlink -f -- "$0")
ROOT=$(dirname -- "$SELF")
fail() { echo sqlite_runtime_artifact_changed >&2; exit 78; }
check() {
  [ -f "$ROOT/$1" ] && [ ! -L "$ROOT/$1" ] || fail
  SIZE=$(/usr/bin/stat -c%s -- "$ROOT/$1" 2>/dev/null) || fail
  [ "$SIZE" -le 524288 ] || fail
  SUM=$(/usr/bin/timeout -k 1 5 /usr/bin/sha256sum -- "$ROOT/$1" 2>/dev/null) || fail
  [ "${SUM%% *}" = "$2" ] || fail
}
