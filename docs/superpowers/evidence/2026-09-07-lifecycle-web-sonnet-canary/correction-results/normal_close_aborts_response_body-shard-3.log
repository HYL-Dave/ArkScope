    def _page_text(body: bytes, content_type: str) -> tuple[str, str]:
        header = Message()
        header["Content-Type"] = content_type
        mime = header.get_content_type()
        if mime not in {"text/plain", "text/html", "application/xhtml+xml"}:
            raise SourceReadError("source_format_unsupported")
        charset = header.get_content_charset() or "utf-8"
        try:
            text = body.decode(charset, errors="strict")
        except (LookupError, UnicodeError):
            raise SourceReadError("source_encoding_unsupported") from None
        if mime != "text/plain":
            parser = _SourceTextParser()
            parser.feed(text)
            parser.close()
            text = "".join(parser.parts)
        text = re.sub(r"\s+", " ", text).strip()
        if not text:
