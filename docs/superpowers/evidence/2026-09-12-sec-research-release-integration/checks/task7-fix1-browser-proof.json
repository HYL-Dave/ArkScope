mpts)\nscreenshots=sorted(browser.glob(\"*.png\")); assert len(screenshots)==16\nartifacts=[dict(path=str(p.relative_to(work)),bytes=p.stat().st_size,sha256=sha(p)) for p in sorted(browser.iterdir()) if p.is_file()]\nhelpers=[dict(path=str(p.relative_to(work)),sha256=sha(p)) for p in [work/\"browser_check.py\",work/\"browser_fixture.py\",work/\"vite-preview.mjs\",work/\"browser-fixture/main.tsx\",work/\"browser-fixture/index.html\"]]\nfreeze=json.loads((work/\"task7-fix1-proof-readback.json\").read_text())\nassert all(sha(root/r[\"path\"])==r[\"sha256\"] for r in freeze[\"sources\"])\nprint(json.dumps(dict(runner=\"task7-fix1-29-browser-final\",source_freeze_matches=True,sources=freeze[\"sources\"],cases=[r[\"case\"] for r in results[\"measurements\"]],api_count=len(api),api_owners=dict(collections.Counter(r[\"owner\"] for r in api)),api_statuses=dict(collections.Counter(r[\"status\"] for r in api)),metadata_attempts=len(sources[\"source_dispatches\"]),document_seed_attempts=len(sources[\"document_dispatches\"]),generated_bodies=20,typed_failures=5,confirmed_live_http=0,all_body_hashes_and_lengths_verified=True,bodies=bodies,artifacts=artifacts,helpers=helpers,servers_stopped=True,verification_scope=results[\"verification_scope\"],unrelated_generated_endpoints=results[\"unrelated_generated_endpoints\"])))\n'",
