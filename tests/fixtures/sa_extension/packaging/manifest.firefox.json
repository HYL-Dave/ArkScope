{
  "manifest_version": 3,
  "name": "Synthetic SA fixture",
  "version": "1.0.0",
  "background": {
    "scripts": [
      "compat_firefox.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.asset"
  },
  "content_scripts": [
    {
      "matches": ["https://example.invalid/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["web.asset"],
      "matches": ["https://example.invalid/*"]
    }
  ]
}
